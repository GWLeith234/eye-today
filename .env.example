# Copy to .env.local for local development. Never commit real values.

# Supabase project URL. Public: shipped to the browser.
# Local: http://127.0.0.1:54321 (printed by `npx supabase start`).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key. Public: safe in the browser, RLS enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SERVER ONLY — bypasses RLS.
# Never prefix with NEXT_PUBLIC_. Used only by src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Supabase project ref, used only by `npx supabase link --project-ref`.
# Not read by the app. Must point at the new Eye Today project, never Evolved Pros.
SUPABASE_PROJECT_REF=

# Optional. Public origin used for auth redirect links (e.g. https://eye-today-web-production.up.railway.app).
# When blank, the origin comes from the request's Host / X-Forwarded-* headers.
SITE_URL=

# Server only. Shared secret for POST /api/cron/publish (Authorization: Bearer <CRON_SECRET>).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Server only. HMAC key for /preview/<id>?token=… links minted by the editor.
# Generate with: openssl rand -hex 32
PREVIEW_SECRET=

# Optional. "true" when Supabase image transformations are enabled on the project;
# media URLs then request resized renditions. Leave blank to use the original files.
NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORMS=

# Cloudflare Turnstile for /write-for-us. The site key is public (sent to the browser);
# the secret is server only. Without the secret, the form refuses applications.
# For local .env.local only, Cloudflare's always-pass test keys are:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Never commit those as defaults.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server only. Resend for editorial notifications (submitted / changes requested / published).
# RESEND_FROM must be a verified sender, e.g. "Eye Today <newsroom@example.com>".
# When unset, actions still succeed and report that email was not sent.
RESEND_API_KEY=
RESEND_FROM=
# Optional. "mock" writes messages to E2E_MAILBOX_PATH instead of calling Resend.
# Leave unset in production. Resend stays the default.
EMAIL_PROVIDER=
# File the mock provider appends JSON lines to (to, subject, text, html). Server only.
E2E_MAILBOX_PATH=

# Server only. Salt for hashing visitor IPs when counting article views (/api/view).
# Generate with: openssl rand -hex 32. When blank, a fixed built-in salt is used.
VIEW_HASH_SALT=

# Server only. Anthropic API for the editor's AI assistant (headlines, dek, SEO, tags, copy edit,
# claims check, key points). Never prefix with NEXT_PUBLIC_. ANTHROPIC_MODEL is the model id to call.
# When either is blank the assistant panel says it is not configured and no request is made.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Server only. Newsletters (double opt-in signup, issues, sends). None of these start with NEXT_PUBLIC_.
# With any of RESEND_API_KEY, RESEND_FROM, NEWSLETTER_POSTAL_ADDRESS, NEWSLETTER_LINK_SECRET or SITE_URL
# blank, signup and sending report "Email is not configured." and make no network call.
# Postal address printed in every issue footer (required for commercial email).
NEWSLETTER_POSTAL_ADDRESS=
# Derives the unsubscribe links. Signs nothing else; do not reuse PREVIEW_SECRET. Generate with: openssl rand -hex 32
# Changing it later invalidates the unsubscribe links in issues already sent.
NEWSLETTER_LINK_SECRET=
# Signing secret of the Resend webhook pointed at POST /api/webhooks/resend (starts with whsec_).
# Blank: the webhook answers 400 and records nothing.
RESEND_WEBHOOK_SECRET=

# Server only. Stripe supporter membership (test keys until launch). None start with NEXT_PUBLIC_;
# there is no publishable key because Checkout is a server redirect. With any of these blank,
# /support says "Payments are not open yet." and no Stripe call is made. Checkout also needs SITE_URL.
# Create the prices with: STRIPE_SECRET_KEY=sk_test_... node scripts/stripe-seed.mjs
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint POST /api/webhooks/stripe (whsec_..., or from `stripe listen`).
STRIPE_WEBHOOK_SECRET=
# Price ids printed by scripts/stripe-seed.mjs.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_ONCE=
# Test only. Set to 1 at build time to compile in POST /api/e2e/session and the in-process
# Stripe double. Never set this on a Railway build. Runtime cannot turn it on afterwards.
E2E_FULL=
# File the Stripe double appends checkout sessions to (customer, price, mode). Server only.
E2E_STRIPE_LOG=

# Public. Plausible site domain (the domain you added in Plausible, not a secret).
# When blank, the cookieless script is not rendered and /admin/analytics explains that.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Server only. Plausible Stats API key for /admin/analytics. Never prefix with NEXT_PUBLIC_.
# When blank, the analytics page stays empty and no request is made.
PLAUSIBLE_API_KEY=

# Server only. Sentry DSN for server-side errors and the CSP report endpoint.
# When blank, Sentry is not initialized. A DSN is an identifier; the auth token below is the secret.
SENTRY_DSN=

# Public. Same DSN, for the browser SDK. When blank, the browser does not report errors.
NEXT_PUBLIC_SENTRY_DSN=

# Server only. Source maps upload on `next build` only when all three are set.
# SENTRY_AUTH_TOKEN is a secret. Never prefix it with NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
